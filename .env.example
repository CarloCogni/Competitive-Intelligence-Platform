SECRET_KEY=your-django-secret-key-here
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
RUN_SCHEDULER=true

# Your organisation (the entities marked is_primary in entities.json)
PRIMARY_ORG_NAME=Blockstream
PRIMARY_ORG_DESCRIPTION=a Bitcoin infrastructure company

# Optional — higher GitHub API rate limits (60 requests/hr without)
GITHUB_TOKEN=<your-github-token>

# Twitter API needs payment subscription
TWITTER_BEARER_TOKEN=<your-twitter-bearer-token>
